---
const { sources = [], fieldSources = null, heading = null } = Astro.props;
const fields = Object.entries(fieldSources ?? {});
---
{heading ? <h3 class="refhead">{heading}</h3> : <h2>Sources</h2>}
<ul class="sources">
  {sources.map((s) => (
    <li><a href={s.url} target="_blank" rel="noopener noreferrer">{s.url}</a>{s.note && <span class="mute"> — {s.note}</span>}</li>
  ))}
  {fields.map(([field, url]) => (
    <li><span class="mono">{field}</span>: <a href={url} target="_blank" rel="noopener noreferrer">{url}</a></li>
  ))}
</ul>
