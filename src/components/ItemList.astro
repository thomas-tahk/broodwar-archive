---
// Items (interviews, articles...) linked to a record; each row opens the item page, which has the external links.
import { itemsLinkingTo, href, ymd } from '../lib/catalog.js';

const { ref } = Astro.props;
const found = itemsLinkingTo(ref);
---
<h2>Items ({found.length})</h2>
{found.length === 0 ? (
  <p class="state">No items linked yet. Know an interview or article about this? See the contributing guide in the footer.</p>
) : (
  <ul class="items">
    {found.map((i) => (
      <li><a href={href(`items/${i.id}/`)}>{i.title}</a> <span class="mute">{i.kind} · {ymd(i.date)}</span></li>
    ))}
  </ul>
)}
