---
// "What's missing" panel (issue #16): plain-words gaps for one event or match, each with a prefilled issue-form link.
import { REPO_URL } from '../lib/catalog.js';
import { missingItems, formUrl } from '../lib/help.js';

const { record, matches = [] } = Astro.props;
const recordId = record.fullId ?? record.id;
const items = missingItems(record, matches).map((i) => ({ ...i, url: formUrl(REPO_URL, i.form, { recordId, game: i.game }) }));
---
{items.length > 0 && (
  <section class="missing" aria-labelledby="missing-h">
    <h2 id="missing-h">What's missing</h2>
    <ul>
      {items.map((i) => (
        <li><span>{i.text}</span> <a class="helpbtn" href={i.url} rel="noopener noreferrer">{i.label}</a></li>
      ))}
    </ul>
  </section>
)}
