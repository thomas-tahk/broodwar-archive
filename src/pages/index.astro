---
import Base from '../layouts/Base.astro';
import { events, matchesOf, href } from '../lib/catalog.js';
---
<Base title="Events">
  <p class="kicker">Index // events</p>
  <h1>Brood War broadcast archive</h1>
  <p class="mute">Where each game's footage survives, and how good it is. Link index only.</p>
  <h2>Events</h2>
  {events.length === 0 ? (
    <p class="state">No events in the catalog yet.</p>
  ) : (
    <ul class="list">
      {events.map((e) => (
        <li class="panel"><a class="card" href={href(`events/${e.id}/`)}>
          <h3>{e.name}</h3>
          <p class="meta">{e.year ?? 'Unknown'} · {e.broadcaster ?? 'Broadcaster unknown'} · {matchesOf(e.id).length} matches</p>
        </a></li>
      ))}
    </ul>
  )}
</Base>
