---
import Base from '../layouts/Base.astro';
import Season from '../components/Season.astro';
import { events, matchesOf, copyCount, href } from '../lib/catalog.js';

const [featured, ...others] = events;
const matches = featured ? matchesOf(featured.id) : [];
const games = matches.reduce((n, m) => n + m.games.length, 0);
const videos = matches.reduce((n, m) => n + copyCount(m), 0);
---
<Base title="Season" nav="season">
  {!featured ? (
    <>
      <h1>Brood War broadcast archive</h1>
      <p class="state">No events in the catalog yet.</p>
    </>
  ) : (
    <>
      <p class="kicker">Brood War broadcast archive</p>
      <h1>{featured.name}</h1>
      <p class="meta">
        {featured.year ?? 'Unknown'} · {featured.broadcaster ?? 'Broadcaster unknown'} · {matches.length} matches · {games} games · {videos} videos
      </p>
      <Season event={featured} matches={matches} />
      <p class="gap-help"><a href={href(`events/${featured.id}/`)}>Event details, gap view and sources</a></p>
      {others.length > 0 && (
        <>
          <h2>More events</h2>
          <ul class="events">
            {others.map((e) => (
              <li><a href={href(`events/${e.id}/`)}><strong>{e.name}</strong><span class="meta">{e.year ?? 'Unknown'} · {e.broadcaster ?? 'Broadcaster unknown'} · {matchesOf(e.id).length} matches</span></a></li>
            ))}
          </ul>
        </>
      )}
    </>
  )}
</Base>
