---
import Base from '../layouts/Base.astro';
import { events, href } from '../lib/catalog.js';
import { leagueMenu, featuredCards, timeline, latestAdditions } from '../lib/home.js';

const leagues = leagueMenu();
const cards = featuredCards();
const years = timeline();
const latest = latestAdditions();
---
<Base title="Home" nav="home">
  <p class="kicker">Brood War broadcast archive</p>
  <h1>Every game, every broadcast</h1>
  {events.length === 0 ? (
    <p class="state">No events in the catalog yet.</p>
  ) : (
    <>
      {leagues.length > 0 && (
        <nav class="leagues" aria-label="Leagues">
          {leagues.map((s) => <a href={href(`series/${s.id}/`)}>{s.name}</a>)}
        </nav>
      )}
      {cards.length > 0 && (
        <section aria-labelledby="featured-h">
          <h2 id="featured-h">Featured</h2>
          <ul class="cards">
            {cards.map((c) => (
              <li><a href={c.href}><span class="tick cy"><span>{c.type}</span></span><strong>{c.label}</strong>{c.blurb && <span class="meta">{c.blurb}</span>}</a></li>
            ))}
          </ul>
        </section>
      )}
      <section aria-labelledby="years-h">
        <h2 id="years-h">Browse by year</h2>
        <ol class="years">
          {years.map((y) => (
            <li>
              <h3>{y.year ?? 'Year unknown'}</h3>
              {y.bands.map((b) => <a class="band" href={b.href}>{b.label}</a>)}
              {y.chips.length > 0 && (
                <ul class="chips">
                  {y.chips.map((c) => <li><a href={c.href}>{c.label}<span class="mute"> · {c.kind}</span></a></li>)}
                </ul>
              )}
            </li>
          ))}
        </ol>
      </section>
      {latest.length > 0 && (
        <section aria-labelledby="latest-h">
          <h2 id="latest-h">Latest additions</h2>
          <ul class="chips">
            {latest.map((c) => <li><a href={c.href}>{c.label}<span class="mute"> · {c.kind}</span></a></li>)}
          </ul>
        </section>
      )}
    </>
  )}
</Base>
