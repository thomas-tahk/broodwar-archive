---
// Find a game: race-vs-race table, map chips, player select. Every game is rendered at build time;
// a small inline script hides rows that don't match (data-* attributes carry the filter keys).
import Base from '../../layouts/Base.astro';
import GradeBadge from '../../components/GradeBadge.astro';
import QualityLegend from '../../components/QualityLegend.astro';
import Race from '../../components/Race.astro';
import { allMatches, maps, playerOf, stageOf, ymd, href } from '../../lib/catalog.js';
import { bestGrade } from '../../../tools/catalog/grades.js';

const RACES = ['T', 'P', 'Z'];
const NAMES = { T: 'Terran', P: 'Protoss', Z: 'Zerg' };
const ordered = [...allMatches].sort((a, b) => (a.date ?? '9999').localeCompare(b.date ?? '9999') || a.id.localeCompare(b.id));
const games = ordered.flatMap((m) => m.games.map((g) => {
  const [x, y] = g.races ?? [];
  const known = RACES.includes(x) && RACES.includes(y);
  return { m, g, mu: known ? [x, y].sort().join('') : '' };
}));
const countMu = (k) => games.filter((r) => r.mu === k).length;
const unknownRaces = games.filter((r) => !r.mu).length;
const mapIds = [...new Set(games.map((r) => r.g.map).filter(Boolean))];
const mapName = (id) => maps.get(id)?.name ?? id;
const mapCount = (id) => games.filter((r) => r.g.map === id).length;
const playerIds = [...new Set(games.flatMap((r) => r.m.players))];
const nameOf = (id) => playerOf(id).name ?? 'Unknown';
playerIds.sort((a, b) => nameOf(a).localeCompare(nameOf(b)));
const pairKey = (r, c) => [r, c].sort().join('');
---
<Base title="Find a game" nav="find">
  <p class="kicker">Brood War broadcast archive</p>
  <h1>Find a game</h1>
  <noscript><p class="state">Filters need JavaScript. Every game is listed below.</p></noscript>

  {games.length === 0 ? (
    <p class="state">No games in the catalog yet.</p>
  ) : (
    <>
      <div class="js-only" id="filters">
        <div class="grp">Race vs race</div>
        <div class="mx" role="group" aria-label="Race vs race">
          <div></div>
          {RACES.map((c) => <div>{c} · {NAMES[c]}</div>)}
          {RACES.map((r) => (
            <>
              <div class="rh">{r} · {NAMES[r]}</div>
              {RACES.map((c) => (
                <button type="button" data-mu={pairKey(r, c)} aria-pressed="false" aria-label={`${NAMES[r]} vs ${NAMES[c]}, ${countMu(pairKey(r, c))} games`}>
                  <span aria-hidden="true"><b>{countMu(pairKey(r, c))}</b>{r}v{c}</span>
                </button>
              ))}
            </>
          ))}
        </div>
        <p class="meta">Tap a square to filter; tap again to clear. Mirror squares (like TvP and PvT) are the same matchup. {unknownRaces > 0 && `${unknownRaces} games have unknown races and never match.`}</p>

        <div class="grp">Map</div>
        <div class="chips" role="group" aria-label="Map">
          {mapIds.map((id) => <button type="button" data-map={id} aria-pressed="false">{mapName(id)} {mapCount(id)}</button>)}
        </div>

        <div class="grp"><label for="pl">Player</label></div>
        <select class="fsel" id="pl">
          <option value="">Any player</option>
          {playerIds.map((id) => <option value={id}>{nameOf(id)}</option>)}
        </select>
        <div><button type="button" class="ghost" id="clear">Clear filters</button></div>
      </div>

      <h2>Results</h2>
      <p id="count" role="status" class="meta">{games.length} games</p>
      <p id="none" class="state" hidden>No games match. Clear a filter.</p>
      <ul class="rows" id="results">
        {games.map(({ m, g, mu }) => {
          const [a, b] = m.players.map(playerOf);
          const copies = (g.copies ?? []).length;
          return (
            <li class="frow" data-mu={mu} data-map={g.map ?? ''} data-players={m.players.join(' ')}>
              <a class="row" href={href(`matches/${m.event}/${m.id}/#game-${g.set}`)}>
                <span class="when">{ymd(m.date)}<br />{stageOf(m)} · G{g.set}</span>
                <span class="sb">
                  <span class={g.winner && g.winner === a.id ? 'win' : ''}><Race race={g.races?.[0] ?? null} /> {a.name ?? 'Unknown'}</span>
                  <b>vs</b>
                  <span class={g.winner && g.winner === b.id ? 'win' : ''}>{b.name ?? 'Unknown'} <Race race={g.races?.[1] ?? null} /></span>
                </span>
                <span class="info">{g.map ? mapName(g.map) : 'Map unknown'} <GradeBadge grade={bestGrade(g)} none={copies === 0} /> <span class={`vid ${copies ? '' : 'none'}`}>{copies ? `▶ ${copies} video${copies === 1 ? '' : 's'}` : 'No video known'}</span></span>
              </a>
            </li>
          );
        })}
      </ul>
      <QualityLegend />
    </>
  )}
<script is:inline>
  (function () {
    var filters = document.getElementById('filters');
    if (!filters) return;
    var rows = document.querySelectorAll('.frow');
    var state = { mu: '', map: '', pl: '' };
    var mxBtns = filters.querySelectorAll('.mx button');
    var mapBtns = filters.querySelectorAll('[data-map]');
    var sel = document.getElementById('pl');
    function draw() {
      var shown = 0;
      rows.forEach(function (r) {
        var ok = (!state.mu || r.dataset.mu === state.mu) && (!state.map || r.dataset.map === state.map) &&
          (!state.pl || r.dataset.players.split(' ').indexOf(state.pl) >= 0);
        r.hidden = !ok;
        if (ok) shown++;
      });
      mxBtns.forEach(function (b) { b.setAttribute('aria-pressed', b.dataset.mu === state.mu); });
      mapBtns.forEach(function (b) { b.setAttribute('aria-pressed', b.dataset.map === state.map); });
      document.getElementById('count').textContent = shown + (shown === 1 ? ' game' : ' games') + (shown === rows.length ? '' : ' of ' + rows.length);
      document.getElementById('none').hidden = shown !== 0;
    }
    mxBtns.forEach(function (b) { b.addEventListener('click', function () { state.mu = state.mu === b.dataset.mu ? '' : b.dataset.mu; draw(); }); });
    mapBtns.forEach(function (b) { b.addEventListener('click', function () { state.map = state.map === b.dataset.map ? '' : b.dataset.map; draw(); }); });
    sel.addEventListener('change', function () { state.pl = sel.value; draw(); });
    document.getElementById('clear').addEventListener('click', function () { state = { mu: '', map: '', pl: '' }; sel.value = ''; draw(); });
  })();
</script>
</Base>
