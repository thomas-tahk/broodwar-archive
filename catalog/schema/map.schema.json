{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "map.schema.json",
  "type": "object",
  "required": ["id", "name", "version", "sources"],
  "additionalProperties": false,
  "properties": {
    "id": { "$ref": "common.schema.json#/definitions/id" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "$ref": "common.schema.json#/definitions/nullableString" },
    "sources": { "$ref": "common.schema.json#/definitions/sources" },
    "field_sources": { "$ref": "common.schema.json#/definitions/fieldSources" }
  }
}
