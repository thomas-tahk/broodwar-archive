{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "item.schema.json",
  "type": "object",
  "required": ["id", "kind", "title", "date", "language", "urls", "links", "sources"],
  "additionalProperties": false,
  "properties": {
    "id": { "$ref": "common.schema.json#/definitions/id" },
    "kind": { "$ref": "common.schema.json#/definitions/id" },
    "title": { "type": "string", "minLength": 1 },
    "date": { "type": ["string", "null"], "format": "date" },
    "language": { "$ref": "common.schema.json#/definitions/nullableString" },
    "urls": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/definitions/url" } },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "about": { "$ref": "#/definitions/itemRefs" },
        "from": { "$ref": "#/definitions/itemRefs" },
        "features": { "$ref": "#/definitions/itemRefs" }
      }
    },
    "sources": { "$ref": "common.schema.json#/definitions/sources" },
    "field_sources": { "$ref": "common.schema.json#/definitions/fieldSources" }
  },
  "definitions": {
    "itemRefs": { "type": "array", "items": { "$ref": "common.schema.json#/definitions/itemRef" } }
  }
}
