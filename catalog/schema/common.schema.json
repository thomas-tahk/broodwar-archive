{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "common.schema.json",
  "definitions": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "nullableId": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z0-9-]+$"
    },
    "url": {
      "type": "string",
      "pattern": "^https?://[^\\s]+$"
    },
    "nullableString": {
      "type": [
        "string",
        "null"
      ]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "url"
        ],
        "additionalProperties": false,
        "properties": {
          "url": {
            "$ref": "#/definitions/url"
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "fieldSources": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/url"
      }
    },
    "itemRef": {
      "type": "string",
      "pattern": "^(event|player|map):[a-z0-9-]+$|^match:[a-z0-9-]+/[a-z0-9-]+$"
    },
    "anyRef": {
      "type": "string",
      "pattern": "^(series|event|player|map|item):[a-z0-9-]+$|^match:[a-z0-9-]+/[a-z0-9-]+$"
    }
  }
}
